# syntax=docker/dockerfile:1.7
# apps/web — Next.js storefront, standalone self-hosted build (Docker/Coolify).
# Vercel deploys don't use this file at all — Vercel builds apps/web directly.
FROM node:20-bookworm-slim AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
# Pin the exact pnpm version explicitly instead of trusting corepack's lazy
# fetch-on-first-use — must match package.json's "packageManager" field.
RUN corepack enable && corepack prepare pnpm@9.12.0 --activate

FROM base AS deps
WORKDIR /repo
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY apps/web/package.json apps/web/package.json
RUN --mount=type=cache,target=/pnpm/store,sharing=locked \
    pnpm install --frozen-lockfile

FROM base AS builder
WORKDIR /repo
ENV NEXT_TELEMETRY_DISABLED=1
# NEXT_PUBLIC_* vars are inlined into the client JS bundle at build time —
# ContactForm.tsx is a Client Component that calls the API directly from the
# browser, so this MUST be a build arg, not just a runtime `environment:` in
# docker-compose.yaml (that would only affect the server-side process, and the
# browser bundle would silently fall back to localhost:4000).
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
COPY --from=deps /repo/node_modules ./node_modules
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY apps/web ./apps/web
COPY --from=deps /repo/apps/web/node_modules ./apps/web/node_modules
RUN --mount=type=cache,target=/repo/apps/web/.next/cache,sharing=locked \
    pnpm --filter @veblyss/web build

FROM base AS runtime
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

RUN useradd --create-home --uid 1001 veblyss

# output: "standalone" traces the minimal server + node_modules needed to run,
# shaped to match outputFileTracingRoot (repo root) — hence apps/web/... below.
# --chown to veblyss: the ISR/prerender cache gets written at runtime under
# .next/server/app/, and the process runs as veblyss (see USER below), not
# root — files copied without --chown are root-owned and unwritable, so ISR
# cache writes fail with EACCES on every request.
COPY --from=builder --chown=veblyss:veblyss /repo/apps/web/.next/standalone ./
COPY --from=builder --chown=veblyss:veblyss /repo/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder --chown=veblyss:veblyss /repo/apps/web/public ./apps/web/public

USER veblyss
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s \
    CMD node -e "fetch('http://127.0.0.1:3000/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "apps/web/server.js"]
