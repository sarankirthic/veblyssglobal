# syntax=docker/dockerfile:1.7
# apps/api — Flask REST API (see docs/ARCHITECTURE.md §10)
FROM python:3.12-slim-bookworm AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# psycopg2 needs libpq at build + runtime; Pillow needs libjpeg/zlib at runtime.
# Cache mounts (not `rm -rf .../apt/lists`) — BuildKit cache mounts never get
# committed to the image layer, so there's nothing to clean up, and repeat
# builds don't re-download the same .deb files over the network.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    libpq5 libjpeg62-turbo zlib1g

FROM base AS builder
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    build-essential libpq-dev libjpeg-dev zlib1g-dev

COPY apps/api/requirements.txt .
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --user -r requirements.txt

FROM base AS runtime
RUN useradd --create-home --uid 1000 veblyss

COPY --from=builder --chown=veblyss:veblyss /root/.local /home/veblyss/.local
ENV PATH=/home/veblyss/.local/bin:$PATH

COPY --chown=veblyss:veblyss apps/api/ .
COPY --chown=veblyss:veblyss docker/entrypoint-api.sh /usr/local/bin/entrypoint-api.sh
RUN chmod +x /usr/local/bin/entrypoint-api.sh

USER veblyss

EXPOSE 4000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s \
    CMD python -c "import urllib.request,sys; sys.exit(0) if urllib.request.urlopen('http://127.0.0.1:4000/api/v1/health').status == 200 else sys.exit(1)"

# Runs `flask db upgrade` before handing off to gunicorn — see docker/entrypoint-api.sh.
ENTRYPOINT ["entrypoint-api.sh"]
CMD ["gunicorn", "--bind", "0.0.0.0:4000", "--workers", "4", "--access-logfile", "-", "wsgi:app"]
