# Copy to .env and fill in real values. Never commit .env.
#
# Going to production? These MUST be real, not left as dev defaults:
#   SECRET_KEY, DATABASE_URL, CORS_ORIGINS, R2_* — see PRODUCTION_CHECKLIST.md
# at the repo root for the full pre-launch list.

FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-64-char-string

DATABASE_URL=postgresql+psycopg2://veblyss:veblyss@localhost:5432/veblyss

# Session cookies — SESSION_COOKIE_SECURE must be false for local http://localhost
# dev (browsers drop Secure cookies on non-https origins); set true in production.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_NAME=veblyss_session
SESSION_LIFETIME_DAYS=7

# CORS — comma-separated origins allowed to call this API with credentials
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=veblyss-media
R2_PUBLIC_BASE_URL=https://media.veblyssglobal.com

# Redis (optional caching layer — see ARCHITECTURE.md §8)
REDIS_URL=

LOG_LEVEL=INFO
