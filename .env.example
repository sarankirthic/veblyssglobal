# Root .env — read by `docker compose` (Dokploy, or local `docker compose up`).
# Copy to .env and fill in real values. Never commit .env.
#
# Going to production? These MUST be real, not left as dev defaults:
#   SECRET_KEY, CORS_ORIGINS, NEXT_PUBLIC_API_URL, R2_* — see
# PRODUCTION_CHECKLIST.md at the repo root for the full pre-launch list.
#
# NOTE: DATABASE_URL and REDIS_URL are NOT set here — docker-compose.yaml
# hardcodes veblyss.api's DATABASE_URL/REDIS_URL to the compose network's
# internal service names (veblyss.postgres/veblyss.redis) and ignores any
# value from this file. Those two only matter for apps/api/.env, used by the
# local, non-Docker `./start.sh dev` workflow — see that file, not this one.

FLASK_ENV=production
SECRET_KEY=change-me-to-a-random-64-char-string

# Session cookies
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_NAME=veblyss_session
SESSION_LIFETIME_DAYS=7

# CORS — comma-separated origins allowed to call this API with credentials
CORS_ORIGINS=https://veblyssglobal.com

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=veblyss-media
R2_PUBLIC_BASE_URL=https://media.veblyssglobal.com

LOG_LEVEL=INFO

# apps/web build-time API URL — baked into the browser bundle at build time
# (Dockerfile.web build arg, see docker-compose.yaml `web.build.args`). Must
# be the real public API domain, not a Docker-internal service name — the
# customer's browser can't resolve those.
NEXT_PUBLIC_API_URL=https://api.veblyssglobal.com

# Cloudflare Tunnel — only read by the optional `cloudflared` service
# (profiles: ["tunnel"]). Leave unset if Dokploy's own ingress is fronting
# traffic (the default / recommended setup — see README.md#deployment).
CLOUDFLARE_TUNNEL_TOKEN=

# Uncomment to actually start the `cloudflared` service above (equivalent to
# `docker compose --profile tunnel up`). Required on Dokploy specifically —
# it has no UI field for compose --profile flags, so this env var is the
# only way to enable it there. See PRODUCTION_CHECKLIST.md.
# COMPOSE_PROFILES=tunnel
